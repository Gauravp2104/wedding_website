# ─────────────────────────────────────────────────────────────
#  Gautam & Sandhya Wedding — Backend configuration
#  Copy this file to ".env" and adjust as needed.
#  Every RSVP is saved to data/rsvps.json. Photos go to data/uploads/.
# ─────────────────────────────────────────────────────────────

PORT=4000

# Point at a persistent volume in production so data survives restarts,
# e.g. DATA_DIR=/data  (RSVPs → /data/rsvps.json, photos → /data/uploads).
# DATA_DIR=/data

# ── Photo album admin ────────────────────────────────────────
# Shared password required to upload photos to the album.
ADMIN_PASSWORD=choose-a-private-password

# ── RSVP confirmation texts (Twilio SMS) ──────────────────────
# Phone is a required field on the RSVP form, so this is the guaranteed
# confirmation channel: every RSVP (new or edited) texts the guest a
# "thanks for RSVPing" message + an "edit my RSVP" link. Without these set,
# RSVPs still save fine; texting is just skipped (and logged).
#
# Get these from https://console.twilio.com — TWILIO_FROM_NUMBER is a phone
# number you've bought/verified in that Twilio account.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+14155550123

# ── RSVP confirmation emails (SMTP via nodemailer, optional) ──
# Email is optional on the form — if a guest leaves one, they *also* get an
# HTML confirmation with a Google Calendar "Add to calendar" link per
# ceremony. Without SMTP_USER/SMTP_PASS set, this is just skipped.
#
# Easiest option: a Gmail address + an "app password" (Google Account →
# Security → 2-Step Verification → App passwords — a regular Gmail password
# won't work here).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-16-char-app-password

# Sender shown on the confirmation email. Defaults to SMTP_USER.
# RSVP_FROM_EMAIL="Gautam & Sandhya <your-address@gmail.com>"

# Base URL used to build the "edit my RSVP" link in texts/emails. Defaults
# to the incoming request's own host, which is right in production — set
# this only if that's ever wrong (e.g. behind a proxy that hides the host).
# SITE_URL=https://gautam-sandhya.vercel.app
