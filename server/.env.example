# ─────────────────────────────────────────────────────────────
#  Gautam & Sandhya Wedding — Backend configuration
#  Copy this file to ".env" and adjust as needed.
#  Every RSVP is saved to data/rsvps.json. Photos go to data/uploads/.
# ─────────────────────────────────────────────────────────────

PORT=4000

# Point at a persistent volume in production so data survives restarts,
# e.g. DATA_DIR=/data  (RSVPs → /data/rsvps.json, photos → /data/uploads).
# DATA_DIR=/data

# ── Photo album admin ────────────────────────────────────────
# Shared password required to upload photos to the album.
ADMIN_PASSWORD=choose-a-private-password

# ── Live Google Sheet sync ─────────────────────────────────────
# Optional — RSVPs save fine without it. See README.md "Live Google Sheet"
# for how to create these (Google Cloud service account + share the sheet
# with its email). Same three vars are set on Vercel for production.
# GOOGLE_SHEETS_ID=1AbCyourSpreadsheetIdFromTheSheetsUrl
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Alternative to the two vars above: paste the whole downloaded JSON key
# file as one value instead.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
# Optional — only needed if you rename the sheet's tab away from the default
# first tab and want to target it explicitly.
# GOOGLE_SHEETS_TAB=RSVPs
